<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, Arial, sans-serif; margin: 0; padding: 12px; background: #f4f4f2; color: #222; }
    h2 { font-size: 16px; margin: 8px 0; }
    .card { background: #fff; border-radius: 10px; padding: 14px; margin-bottom: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
    button { width: 100%; padding: 12px; border-radius: 8px; border: none; font-size: 15px; margin-top: 8px; cursor: pointer; }
    .btn-primary { background: #1D9E75; color: white; }
    .btn-secondary { background: #eee; color: #222; }
    .btn-in { background: #378ADD; color: white; }
    .btn-out { background: #D85A30; color: white; }
    input, select { width: 100%; padding: 10px; margin-top: 4px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; }
    label { font-size: 12px; color: #666; margin-top: 8px; display: block; }
    #reader { width: 100%; border-radius: 8px; overflow: hidden; }
    .row2 { display: flex; gap: 8px; }
    .row2 > div { flex: 1; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px; background: #FAEEDA; color: #854F0B; margin-right: 6px; }
    .badge-wh { background: #DCEBFC; color: #1C5AA6; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 6px; }
    th, td { text-align: left; padding: 5px 4px; border-bottom: 1px solid #eee; }
    .expiry-option { padding: 8px; border: 1px solid #ddd; border-radius: 6px; margin-top: 6px; cursor: pointer; }
    .expiry-option.selected { border-color: #1D9E75; background: #E1F5EE; }
    .msg { padding: 10px; border-radius: 6px; margin-top: 8px; font-size: 13px; }
    .msg-ok { background: #EAF3DE; color: #3B6D11; }
    .msg-err { background: #FCEBEB; color: #A32D2D; }
    .hidden { display: none; }
  </style>
</head>
<body>

  <div class="card">
    <h2>Scan QR</h2>
    <div id="reader"></div>
    <button class="btn-secondary" onclick="restartScanner()">Scan ulang</button>
    <label>Atau cari manual</label>
    <input id="manualWh" placeholder="WH Code, misal WH1">
    <input id="manualCode" placeholder="Code number, misal RM-2200-118" style="margin-top:6px">
    <button class="btn-secondary" onclick="lookupManual()">Cari</button>
  </div>

  <div id="ambiguousCard" class="card hidden">
    <h2 id="ambigName">-</h2>
    <div class="badge" id="ambigCode">-</div>
    <p style="font-size:13px;color:#666;margin-top:10px">Code number ini ada di beberapa WH. Pilih salah satu:</p>
    <div id="ambigOptions"></div>
  </div>

  <div id="itemCard" class="card hidden">
    <h2 id="itemName">-</h2>
    <div class="badge" id="itemCode">-</div>
    <div class="badge badge-wh" id="itemWhBadge">-</div>
    <table>
      <tr><td>UOM</td><td id="itemUom">-</td></tr>
      <tr><td>WH Code</td><td id="itemWh">-</td></tr>
      <tr><td>Location</td><td id="itemLoc">-</td></tr>
      <tr><td><b>Total stock</b></td><td id="itemStock">-</td></tr>
    </table>
    <button class="btn-secondary" onclick="showForm('location')">Ubah lokasi</button>

    <div class="row2" style="margin-top:8px">
      <button class="btn-in" onclick="showForm('receiving')">Receiving</button>
      <button class="btn-out" onclick="showForm('issuing')">Issuing</button>
    </div>

    <h2 style="margin-top:16px">Breakdown expired date</h2>
    <div id="expiryList"></div>

    <h2 style="margin-top:16px">Bin card (10 transaksi terakhir)</h2>
    <table>
      <thead><tr><th>Tgl</th><th>Doc</th><th>Exp</th><th>In</th><th>Out</th><th>Bal</th></tr></thead>
      <tbody id="logBody"></tbody>
    </table>
  </div>

  <div id="locationForm" class="card hidden">
    <h2>Ubah lokasi</h2>
    <label>WH Code</label><input id="locWh">
    <label>Location</label><input id="locLocation">
    <label>Initial store keeper</label><input id="locInitial">
    <button class="btn-primary" onclick="submitLocation()">Simpan lokasi baru</button>
    <button class="btn-secondary" onclick="hideForms()">Batal</button>
    <div id="locMsg"></div>
  </div>

  <div id="receivingForm" class="card hidden">
    <h2>Form receiving</h2>
    <label>Tanggal</label><input type="date" id="rcvDate">
    <label>Doc No (nomor GRN/PO manual)</label><input id="rcvDocNo">
    <label>Expired date barang masuk (kosongkan kalau barang tidak punya expired, misal spare part)</label>
    <input type="date" id="rcvExpDate">
    <label>Quantity masuk</label><input type="number" id="rcvQty">
    <label>Initial store keeper</label><input id="rcvInitial">
    <button class="btn-primary" onclick="submitReceiving()">Simpan baris ini</button>
    <p style="font-size:12px;color:#666;margin-top:8px">Kalau kiriman ini punya beberapa expired date berbeda (misal 600kg exp Des, 400kg exp Feb), simpan dulu baris pertama, lalu isi baris berikutnya dengan doc no yang sama.</p>
    <button class="btn-secondary" onclick="hideForms()">Selesai / tutup</button>
    <div id="rcvMsg"></div>
  </div>

  <div id="issuingForm" class="card hidden">
    <h2>Form issuing</h2>
    <p style="font-size:13px;color:#666">Pilih expired date yang mau dikeluarkan (paling atas = paling dekat expired):</p>
    <div id="issuingExpiryOptions"></div>
    <label>Tanggal</label><input type="date" id="isuDate">
    <label>Doc No (nomor issuing manual)</label><input id="isuDocNo">
    <label>Quantity keluar</label><input type="number" id="isuQty">
    <label>User (yang mengambil barang)</label><input id="isuUser">
    <label>Initial store keeper</label><input id="isuInitial">
    <button class="btn-primary" onclick="submitIssuing()">Simpan issuing</button>
    <button class="btn-secondary" onclick="hideForms()">Batal</button>
    <div id="isuMsg"></div>
  </div>

  <script>
    // GANTI dengan URL Web App hasil deploy Anda (Deploy > Manage deployments > Web app URL)
    const API_URL = 'https://warehouseitp.github.io/ExpiredMonitoring/
';

    function callApi(action, payload) {
      return fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action, payload })
      }).then(r => r.json());
    }

    let currentItem = null;
    let selectedExpiry = null;
    let expirySelected = false;
    let scanner = null;

    function startScanner() {
      scanner = new Html5Qrcode("reader");
      scanner.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: 220 },
        (decodedText) => {
          scanner.stop();
          // format QR baru: "WH1|61137588" - format lama (QR sudah kadung diprint): "61137588" saja
          if (decodedText.indexOf('|') !== -1) {
            const parts = decodedText.split('|');
            doLookup(parts[0].trim(), parts[1].trim());
          } else {
            doLookup('', decodedText.trim()); // QR lama, whCode kosong - sistem akan cari otomatis
          }
        }
      ).catch(err => console.log('Kamera tidak bisa diakses:', err));
    }
    function restartScanner() {
      if (scanner) { scanner.stop().catch(()=>{}); }
      setTimeout(startScanner, 300);
    }
    window.onload = startScanner;

    function lookupManual() {
      const wh = document.getElementById('manualWh').value.trim();
      const code = document.getElementById('manualCode').value.trim();
      if (code) doLookup(wh, code);
    }

    function doLookup(whCode, codeNumber, keepReceivingOpen) {
      callApi('lookupItem', { whCode, codeNumber }).then(res => renderItem(res, keepReceivingOpen));
    }

    function renderItem(res, keepReceivingOpen) {
      document.getElementById('ambiguousCard').classList.add('hidden');
      document.getElementById('itemCard').classList.add('hidden');
      if (!keepReceivingOpen) hideForms();

      if (!res.found) { alert(res.message); return; }

      if (res.ambiguous) {
        document.getElementById('ambiguousCard').classList.remove('hidden');
        document.getElementById('ambigName').innerText = res.nama_barang;
        document.getElementById('ambigCode').innerText = res.code_number;
        const optDiv = document.getElementById('ambigOptions');
        optDiv.innerHTML = '';
        res.options.forEach(opt => {
          const el = document.createElement('div');
          el.className = 'expiry-option';
          el.innerText = 'WH: ' + opt.wh_code + ' — Location: ' + (opt.location || '-');
          el.onclick = () => doLookup(opt.wh_code, res.code_number);
          optDiv.appendChild(el);
        });
        return;
      }

      currentItem = res;
      document.getElementById('itemCard').classList.remove('hidden');
      document.getElementById('itemName').innerText = res.nama_barang;
      document.getElementById('itemCode').innerText = res.code_number;
      document.getElementById('itemWhBadge').innerText = 'WH: ' + res.wh_code;
      document.getElementById('itemUom').innerText = res.uom;
      document.getElementById('itemWh').innerText = res.wh_code || '-';
      document.getElementById('itemLoc').innerText = res.location || '-';
      document.getElementById('itemStock').innerText = res.total_stock + ' ' + res.uom;

      const expiryDiv = document.getElementById('expiryList');
      expiryDiv.innerHTML = '';
      if (res.expiry_breakdown.length === 0) {
        expiryDiv.innerHTML = '<p style="font-size:13px;color:#999">Tidak ada stock aktif.</p>';
      }
      res.expiry_breakdown.forEach(r => {
        const expLabel = r.expired_date ? ('Exp: <b>' + r.expired_date + '</b>') : '<i>Tidak ada expired date</i>';
        expiryDiv.innerHTML += '<div class="expiry-option">' + expLabel + ' — Qty: ' + r.qty_available + '</div>';
      });

      const logBody = document.getElementById('logBody');
      logBody.innerHTML = '';
      res.recent_log.forEach(l => {
        logBody.innerHTML += '<tr><td>' + l.date + '</td><td>' + l.doc_no + '</td><td>' + (l.expired_date||'') +
          '</td><td>' + (l.in_qty||'') + '</td><td>' + (l.out_qty||'') + '</td><td>' + l.balance_qty + '</td></tr>';
      });
      if (keepReceivingOpen) {
        document.getElementById('receivingForm').classList.remove('hidden');
      }
    }

    function showForm(type) {
      hideForms();
      if (type === 'location') {
        document.getElementById('locationForm').classList.remove('hidden');
        document.getElementById('locWh').value = currentItem.wh_code || '';
        document.getElementById('locLocation').value = currentItem.location || '';
      } else if (type === 'receiving') {
        document.getElementById('receivingForm').classList.remove('hidden');
        document.getElementById('rcvDate').value = new Date().toISOString().slice(0,10);
      } else {
        document.getElementById('issuingForm').classList.remove('hidden');
        document.getElementById('isuDate').value = new Date().toISOString().slice(0,10);
        const optDiv = document.getElementById('issuingExpiryOptions');
        optDiv.innerHTML = '';
        selectedExpiry = null;
        expirySelected = false;
        currentItem.expiry_breakdown.forEach((r, idx) => {
          const el = document.createElement('div');
          el.className = 'expiry-option';
          const expLabel = r.expired_date ? ('Exp: ' + r.expired_date) : 'Tidak ada expired date';
          el.innerText = expLabel + ' — Qty tersedia: ' + r.qty_available;
          el.onclick = () => {
            document.querySelectorAll('.expiry-option').forEach(e => e.classList.remove('selected'));
            el.classList.add('selected');
            selectedExpiry = r.expired_date;
            expirySelected = true;
          };
          optDiv.appendChild(el);
        });
      }
    }
    function hideForms() {
      document.getElementById('receivingForm').classList.add('hidden');
      document.getElementById('issuingForm').classList.add('hidden');
      document.getElementById('locationForm').classList.add('hidden');
    }

    function submitLocation() {
      const payload = {
        whCode: currentItem.wh_code,
        codeNumber: currentItem.code_number,
        newWhCode: document.getElementById('locWh').value,
        newLocation: document.getElementById('locLocation').value,
        initial: document.getElementById('locInitial').value
      };
      callApi('updateLocation', payload).then(res => {
        const msg = document.getElementById('locMsg');
        msg.className = 'msg ' + (res.success ? 'msg-ok' : 'msg-err');
        msg.innerText = res.message;
        if (res.success) setTimeout(() => doLookup(payload.newWhCode || currentItem.wh_code, currentItem.code_number), 800);
      });
    }

    function submitReceiving() {
      const payload = {
        whCode: currentItem.wh_code,
        codeNumber: currentItem.code_number,
        date: document.getElementById('rcvDate').value,
        docNo: document.getElementById('rcvDocNo').value,
        expiredDate: document.getElementById('rcvExpDate').value,
        inQty: document.getElementById('rcvQty').value,
        initial: document.getElementById('rcvInitial').value
      };
      callApi('receiveStock', payload).then(res => {
        const msg = document.getElementById('rcvMsg');
        msg.className = 'msg ' + (res.success ? 'msg-ok' : 'msg-err');
        msg.innerText = res.message;
        if (res.success) {
          document.getElementById('rcvExpDate').value = '';
          document.getElementById('rcvQty').value = '';
          doLookup(currentItem.wh_code, currentItem.code_number, true);
        }
      });
    }

    function submitIssuing() {
      if (!expirySelected) { alert('Pilih salah satu baris expired date dulu.'); return; }
      const payload = {
        whCode: currentItem.wh_code,
        codeNumber: currentItem.code_number,
        date: document.getElementById('isuDate').value,
        docNo: document.getElementById('isuDocNo').value,
        expiredDate: selectedExpiry,
        outQty: document.getElementById('isuQty').value,
        user: document.getElementById('isuUser').value,
        initial: document.getElementById('isuInitial').value
      };
      callApi('issueStock', payload).then(res => {
        const msg = document.getElementById('isuMsg');
        msg.className = 'msg ' + (res.success ? 'msg-ok' : 'msg-err');
        msg.innerText = res.message;
        if (res.success) setTimeout(() => doLookup(currentItem.wh_code, currentItem.code_number), 800);
      });
    }
  </script>
</body>
</html>
