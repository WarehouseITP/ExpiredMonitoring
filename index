<!DOCTYPE html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Warehouse Stock Scanner - FEFO System</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
  <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-4 text-center">Warehouse QR & FEFO System</h1>
    
    <!-- Form Input / Scan -->
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Warehouse Code (WH)</label>
        <input type="text" id="whCode" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2" placeholder="Contoh: WH-01">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Code Number / QR Item</label>
        <input type="text" id="codeNumber" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2" placeholder="Scan atau ketik kode barang...">
      </div>
      <button onclick="handleLookup()" class="w-full bg-blue-600 text-white p-2 rounded-md font-semibold hover:bg-blue-700">Cek Barang / Stock</button>
    </div>

    <!-- Hasil Pencarian -->
    <div id="resultContainer" class="mt-6 hidden border-t pt-4">
      <h2 class="text-lg font-semibold text-gray-800 mb-2">Informasi Barang</h2>
      <div id="itemInfo" class="bg-gray-50 p-4 rounded-md text-sm space-y-1"></div>
      
      <h3 class="font-semibold text-gray-700 mt-4 mb-2">Expiry Breakdown (FEFO)</h3>
      <div id="expiryBreakdown" class="overflow-x-auto"></div>
    </div>
  </div>

  <script>
    function handleLookup() {
      const whCode = document.getElementById('whCode').value;
      const codeNumber = document.getElementById('codeNumber').value;

      if (!codeNumber) {
        alert('Masukkan Code Number terlebih dahulu!');
        return;
      }

      // Memanggil fungsi doPost di Google Apps Script secara asynchronous
      google.script.run
        .withSuccessHandler(onLookupSuccess)
        .withFailureHandler(onLookupFailure)
        .doPost({
          postData: {
            contents: JSON.stringify({
              action: 'lookupItem',
              payload: { whCode, codeNumber }
            })
          }
        });
    }

    function onLookupSuccess(responseString) {
      const res = JSON.parse(responseString);
      const container = document.getElementById('resultContainer');
      const infoDiv = document.getElementById('itemInfo');
      const expiryDiv = document.getElementById('expiryBreakdown');

      container.classList.remove('hidden');

      if (!res.found) {
        infoDiv.innerHTML = `<p class="text-red-600">${res.message}</p>`;
        expiryDiv.innerHTML = '';
        return;
      }

      infoDiv.innerHTML = `
        <p><strong>Nama Barang:</strong> ${res.nama_barang}</p>
        <p><strong>Kategori:</strong> ${res.kategori} | <strong>UOM:</strong> ${res.uom}</p>
        <p><strong>Lokasi:</strong> ${res.wh_code} - ${res.location}</p>
        <p><strong>Total Stock:</strong> <span class="text-lg font-bold text-blue-600">${res.total_stock}</span></p>
      `;

      let htmlTable = `
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead>
            <tr>
              <th class="px-2 py-1 text-left font-medium text-gray-500">Expired Date</th>
              <th class="px-2 py-1 text-left font-medium text-gray-500">Qty Available</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
      `;

      if (res.expiry_breakdown && res.expiry_breakdown.length > 0) {
        res.expiry_breakdown.forEach(row => {
          htmlTable += `<tr>
            <td class="px-2 py-1">${row.expired_date || 'Tanpa Expired'}</td>
            <td class="px-2 py-1 font-semibold">${row.qty_available}</td>
          </tr>`;
        });
      } else {
        htmlTable += `<tr><td colspan="2" class="px-2 py-1 text-gray-500 text-center">Tidak ada data stock aktif</td></tr>`;
      }

      htmlTable += `</tbody></table>`;
      expiryDiv.innerHTML = htmlTable;
    }

    function onLookupFailure(error) {
      alert('Terjadi kesalahan koneksi: ' + error.message);
    }
  </script>
</body>
</html>
